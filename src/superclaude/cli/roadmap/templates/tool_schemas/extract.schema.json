{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superclaude.dev/roadmap/tool_schemas/extract.schema.json",
  "title": "Roadmap extract step structured output",
  "$comment": "roadmap_ids carries the IDs the extract step surfaces. Extract is the SOURCE of spec_ids (it DEFINES the universe), so the §MVR §3 generator-side subset constraint (roadmap_ids ⊆ envelope.spec_ids ∪ accepted_deviations) is the IDENTITY at extract and is enforced at the downstream generate/merge steps. See validate_id_subset().",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "frontmatter",
    "functional_requirements",
    "non_functional_requirements",
    "roadmap_ids"
  ],
  "properties": {
    "frontmatter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_source",
        "functional_requirements",
        "nonfunctional_requirements",
        "total_requirements",
        "complexity_score",
        "complexity_class",
        "extraction_mode"
      ],
      "properties": {
        "spec_source": { "type": "string" },
        "generated": { "type": "string" },
        "generator": { "type": "string" },
        "functional_requirements": { "type": "integer" },
        "nonfunctional_requirements": { "type": "integer" },
        "total_requirements": { "type": "integer" },
        "complexity_score": { "type": "number" },
        "complexity_class": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"]
        },
        "domains_detected": {
          "type": "array",
          "items": { "type": "string" }
        },
        "risks_identified": { "type": "integer" },
        "dependencies_identified": { "type": "integer" },
        "success_criteria_count": { "type": "integer" },
        "extraction_mode": {
          "type": "string",
          "enum": ["standard", "chunked"]
        }
      }
    },
    "functional_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "paths": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "non_functional_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "complexity_assessment": { "type": "string" },
    "architectural_constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "component_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "source_ref": { "type": "string" }
        }
      }
    },
    "risk_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk", "severity", "mitigation"],
        "properties": {
          "id": { "type": "string" },
          "risk": { "type": "string" },
          "severity": { "type": "string" },
          "mitigation": { "type": "string" }
        }
      }
    },
    "dependency_inventory": {
      "type": "array",
      "items": { "type": "string" }
    },
    "success_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "roadmap_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(FR-\\d+(?:\\.\\d+)?|NFR-\\d+(?:\\.\\d+)?|SC-\\d+|G-\\d+|D-?\\d+|COMP-\\w+|DM-\\w+)$"
      }
    }
  }
}
