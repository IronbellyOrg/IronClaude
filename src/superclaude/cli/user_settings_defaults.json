{
  "outputStyle": "Pragmatic",
  "model": "opus[1m]",
  "effortLevel": "high",
  "alwaysThinkingEnabled": true,
  "verbose": true,
  "teammateMode": "auto",
  "agentPushNotifEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "5000",
    "PONYTAIL_DEFAULT_MODE": "lite"
  },
  "modelSettings": {
    "gpt-6-astra": {
      "effortLevel": "xhigh"
    },
    "gpt-6.1-sol": {
      "effortLevel": "xhigh"
    },
    "gpt-6-sol": {
      "effortLevel": "xhigh"
    },
    "gpt-5.6-sol": {
      "effortLevel": "xhigh"
    }
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "dropbox@claude-plugins-official": true,
    "google-cloud-storage@claude-plugins-official": true,
    "understand-anything@understand-anything": true,
    "ponytail@ironclaude": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Lum1104/Understand-Anything"
      }
    }
  },
  "ironclaudeMarketplace": {
    "name": "ironclaude",
    "owner": {
      "name": "IronClaude"
    },
    "description": "Third-party plugins IronClaude installs by default, each pinned to a reviewed commit",
    "plugins": [
      {
        "name": "ponytail",
        "description": "Ponytail v5.3.3, pinned by IronClaude",
        "source": {
          "source": "github",
          "repo": "DietrichGebert/ponytail",
          "ref": "v5.3.3",
          "sha": "7801d061243d7b753bad0e0b3c057cd250b11755"
        }
      }
    ]
  }
}
