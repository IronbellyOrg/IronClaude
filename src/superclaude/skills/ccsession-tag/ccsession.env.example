# ccsession.env — proxy/auth config for the ccsession wrapper.
#
# How to use:
#   1. Copy this file to ~/.claude/ccsession.env
#   2. Uncomment and fill in your real values below
#   3. Set restrictive permissions: chmod 600 ~/.claude/ccsession.env
#
# Never commit your real ~/.claude/ccsession.env — it contains secrets.
#
# The ccsession wrapper sources this file (if present) before launching
# claude, so every `ccsession <topic>` and `ccsession --list` inherits these
# vars. Override the path by exporting CCSESSION_ENV_FILE before invoking.

# Option A — route through a proxy (e.g. LiteLLM):
# export ANTHROPIC_BASE_URL=http://your-proxy:4000/cli
# export ANTHROPIC_AUTH_TOKEN=sk-...

# Option B — use a direct Anthropic API key:
# export ANTHROPIC_API_KEY=sk-ant-...

# Option C — leave everything commented and rely on `claude login` /
# pre-existing shell env vars. The wrapper is fine with this file being
# essentially empty.
