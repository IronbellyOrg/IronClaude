+    phase, task = config.phases[0], TaskEntry(task_id="T01.99", title="absent")
+    store = FileHandoffStore(config)
+    assert store.read(phase=phase, task=task) is None
+
+
+def test_on_disk_key_is_phase_qualified(tmp_path: Path) -> None:
