+            if gate_result is not None:
+                gate_results.append(gate_result)
+            if kind == "budget":
+                remaining.append(t.task_id)
+
+    results = [results_by_id[t.task_id] for t in tasks if t.task_id in results_by_id]
+    return results, remaining, gate_results
+
