    "0627bf00f5f621b2": {
      "stable_id": "0627bf00f5f621b2",
      "dimension": "architectural_alignment",
      "severity": "MEDIUM",
      "description": "Validation-dimension enumeration is inconsistent between FR-050.5 and the report schema in FR-050.6. FR-050.5 defines 7 dimensions (schema, structure, traceability, cross-file, interleave, decomposition, parseability), but the Blocking-Issue template's \"Dimension\" field in FR-050.6 restricts the allowed values to only 5 (schema|structure|traceability|cross-file|parseability), omitting \"interleave\" and \"decomposition\". A Warning finding raised under those two WARNING-severity dimensions has no valid dimension label to cite, so the report schema cannot faithfully represent every dimension the reflection prompt is required to assess.",
      "location": "semantic:architectural_alignment",
      "source_layer": "semantic",
      "status": "FIXED",
      "first_seen_run": 1,
      "last_seen_run": 1,
      "debate_verdict": null,
      "debate_transcript": null,
      "files_affected": []
    },
    "2f27e7c338bc3c68": {
      "stable_id": "2f27e7c338bc3c68",
      "dimension": "contradiction_detection",
      "severity": "MEDIUM",
      "description": "The spec supports \"2+ agents\" for adversarial validation (FR-050.3), but the merge design only models exactly two agents \u2014 build_adversarial_merge_prompt instructs categorizing findings as \"ONLY_A / ONLY_B\" (\u00a75.2) and the Agent Agreement Analysis table has only \"Agent A\" and \"Agent B\" columns (FR-050.7). With 3+ agents the categorization scheme and table schema are undefined, contradicting the stated 2+ capability.",
      "location": "semantic:contradiction_detection",
      "source_layer": "semantic",
      "status": "FIXED",
      "first_seen_run": 1,
