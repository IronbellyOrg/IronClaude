+def lead_ids(line: str) -> list[str]:
+    """Ids that open a prose line (after list, heading and bold markers), e.g. `**N3.**`, `C9:`."""
+    m = LEAD_RE.match(MARKER_RE.sub("", line, count=1))
+    return id_tokens(m.group()) if m else []
+
+
+def multiset_minus(a: list[str], b: list[str]) -> list[str]:
+    """Distinct tokens of a whose count in a exceeds their count in b."""
+    left: dict[str, int] = {}
+    for t in b:
+        left[t] = left.get(t, 0) + 1
+    out = set()
+    for t in a:
+        if left.get(t, 0):
+            left[t] -= 1
+        else:
+            out.add(t)
+    return sorted(out)
+
