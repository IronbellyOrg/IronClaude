 CM = ("CRITICAL", "MAJOR")
 
 
+def unlabelled_blocking(text: str) -> list[str]:
+    """Ids of review-3 table rows outside the resolution table that are graded `blocking`
+    but carry no severity label: parse_report needs a label, yet such a grade still counts."""
+    out: list[str] = []
+    in_prior = False
+    for line in text.splitlines():
+        if line.lstrip().startswith("#"):
+            in_prior = bool(PRIOR_HEADING_RE.search(line))
+            continue
+        cs = table_cells(line)
+        if in_prior or not cs or is_separator(cs):
+            continue
+        cell = cs[0].strip("*` ")
+        if not ID_CELL_RE.fullmatch(cell) or LABEL_RE.search(line):
+            continue
+        if any(c.lower() in STATUS_WORDS for c in cs[1:]):
+            continue
+        if BLOCKING_RE.search(line.lower()):
+            out += [t for t in id_tokens(cell) if not FR_RE.match(t)]
+    return out
+
+
