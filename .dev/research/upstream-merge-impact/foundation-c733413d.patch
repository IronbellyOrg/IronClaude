+    if (!testFile) {
+      return false;
+    }
+
+    const testDir = dirname(testFile);
+
+    // Check for other test files in same directory
+    if (existsSync(testDir)) {
+      try {
+        const files = readdirSync(testDir);
+        const testFiles = files.filter(f =>
