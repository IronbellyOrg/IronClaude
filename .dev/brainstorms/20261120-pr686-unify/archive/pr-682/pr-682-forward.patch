-    """A tuple of ``CommentFact`` for the issue's comments; every failure is ``comments_unreadable``."""
-    return _rest_read(
-        runner,
-        budget,
-        timeout_for,
-        lambda page: argv_comments_projected(n, page),
-        _comment_fact,
-        COMMENTS_UNREADABLE,
-        COMMENTS_UNREADABLE,
-        False,
-    )
-
-
-@dataclass(frozen=True)
-class StageEvidence:
-    comments: tuple[CommentFact, ...]
-    events: tuple[LabelEvent, ...]
