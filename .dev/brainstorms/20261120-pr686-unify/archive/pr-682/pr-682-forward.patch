-    start, out = ctx.Event(), ctx.Queue()
-    procs = [ctx.Process(target=target, args=args_for(n, start, out)) for n in range(6)]
-    for p in procs:
-        p.start()
-    start.set()
-    results = [out.get(timeout=30) for _ in procs]
-    for p in procs:
-        p.join(timeout=30)
-        assert p.exitcode == 0
-    return results
-
-
