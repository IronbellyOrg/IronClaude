-        "import os, signal\n"
-        "from superclaude.cli.issue_pipeline import approval_record as ar\n"
-        f"d = {str(directory)!r}\n"
-        f"{code}\n"
-        "os.kill(os.getpid(), signal.SIGKILL)\n"
