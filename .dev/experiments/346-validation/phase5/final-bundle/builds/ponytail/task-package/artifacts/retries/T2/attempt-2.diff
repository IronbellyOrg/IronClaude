+    "| N1 | MINOR | non-blocking |\n| N2 | MAJOR | blocking |\n| N3 | MINOR | non-blocking |\n"
+).replace(
+    "## New findings", "## Prior findings\n\n| F16 | no | open |\n\n## New findings"
+)
+MIXED_BASE = "p1\nk1\np2\nk2\np3\nk3\np4\nk4\np5\n"
+MIXED_CUR = (
