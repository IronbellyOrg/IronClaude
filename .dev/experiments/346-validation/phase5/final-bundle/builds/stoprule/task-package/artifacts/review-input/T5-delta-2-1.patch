+def script_hash(records):
+    """sha256 of every script-written record (reviewer lines and chain links excluded)."""
+    lines = [dump(r) for r in records if r.get("k") not in REVIEWER_KINDS + ("chain",)]
+    return sha256_text("\n".join(lines))
+
