+{"ok": true, "seq": 3, "phase": "revise", "review": 1, "fix_cycles": 0, "counts": {"rows": 5, "blocking": 3, "U": 3, "X": 0, "open": 3, "fixed": 0, "verified": 0, "reopened": 0, "deferred": 2}, "loop_decision": "CONTINUE", "delivery_outcome": null, "next_action": "reviser edits the document; then begin --doc <document> for the next review", "decision": {"loop_decision": "CONTINUE", "U": 3, "X": 0, "I": true}, "last_line": "verdict: FAIL"}
