+def tree_digest(*paths: Path) -> dict:
+    """Every file under the given paths, name -> bytes (a dry run must leave it unchanged)."""
+    out = {}
+    for p in paths:
+        files = [p] if p.is_file() else sorted(x for x in p.rglob("*") if x.is_file())
+        for f in files:
+            out[str(f)] = f.read_bytes()
+    return out
