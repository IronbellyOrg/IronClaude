+def rebuild(res, revert):
+    """The revised text with every part in `revert` restored to its baseline units."""
+    bu, ru = res["bu"], res["ru"]
+    seps = (res["bseps"], res["rseps"])
+    out, prev = [], (None, None)  # (base index, revised index) of the last emitted unit, when known
+
+    def emit(side, x, other):
+        nonlocal prev
+        p, own = prev[side], seps[side][x]
+        # a unit that continued a line whose earlier units were dropped takes the break that preceded
+        # the dropped run; a unit that starts its own line keeps its separator (break plus line prefix)
+        sep = seps[side][p + 1] if p is not None and p < x - 1 and "\n" not in own else own
+        out.append(sep + (bu, ru)[side][x].raw)
+        prev = (x, other) if side == 0 else (other, x)
+
+    for region in res["regions"]:
+        if region[0] == "equal":
+            _, i1, _, j1, j2 = region
+            for k in range(j2 - j1):
+                emit(1, j1 + k, i1 + k)
+            continue
+        for part in region[1]:
+            if part in revert:
+                for i in range(part.i1, part.i2):
+                    emit(0, i, None)
+            else:
+                for j in range(part.j1, part.j2):
+                    emit(1, j, None)
+    ends_on_base = prev[0] == len(bu) - 1 and prev[1] != len(ru) - 1
+    out.append(res["btail"] if ends_on_base else res["rtail"])
+    return "".join(out)
+
