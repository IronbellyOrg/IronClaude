+def depends_closure(bad, ledger, per, stale):
+    """Add every finding with an entry that depends: on a reverted entry: one of a reverted
+    finding, or one in `stale` (its hunks are unattributed, so --enforce reverts them)."""
+    by_num = {e.num: e for e in ledger["entries"]}
+    grew = True
+    while grew:
+        grew = False
+        for e in ledger["entries"]:
+            dep = by_num.get(int(e.depends[1:])) if e.depends else None
+            if dep and (dep.finding in bad or dep.num in stale) and e.finding in per and e.finding not in bad:
+                bad.add(e.finding)
+                grew = True
+
+
+def moved_closure(revert, res):
+    """A reverted part restores its moved units, so their moved copies are reverted too."""
+    owner_b, owner_r = {}, {}
+    for region in res["regions"]:
+        if region[0] == "parts":
+            for part in region[1]:
+                owner_b.update((i, part) for i in range(part.i1, part.i2))
+                owner_r.update((j, part) for j in range(part.j1, part.j2))
+    todo = list(revert)
+    while todo:
+        part = todo.pop()
+        partners = [owner_r[res["moved_b"][i]] for i in range(part.i1, part.i2) if i in res["moved_b"]]
+        partners += [owner_b[res["moved_r"][j]] for j in range(part.j1, part.j2) if j in res["moved_r"]]
+        for q in partners:
+            if q not in revert:
+                revert.add(q)
+                todo.append(q)
+
+
+def enforce(args, base_data, base_text, rev_data, rev_text, fb, ledger, ledger_data):
