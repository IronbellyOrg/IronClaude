+             [(1, {"finding": "F1", "op": "replace", "old": OLD, "new": new})])
+    code, out = check(d, capsys)
+    assert code == 0, out
+    assert "status=fixed" in finding_line(out, "F1")
+    assert out.strip().endswith("FIXCHECK exit=0")
