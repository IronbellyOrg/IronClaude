+def _change_on_read(monkeypatch, target: Path, change) -> list[int]:
+    """Patch ``Path.read_bytes`` so ``change(n)`` rewrites ``target`` after its n-th read."""
+    real = Path.read_bytes
+    reads: list[int] = []
+
+    def read_bytes(self):
+        data = real(self)
+        if self == target:
+            reads.append(1)
+            change(len(reads))
+        return data
+
+    monkeypatch.setattr(Path, "read_bytes", read_bytes)
+    return reads
+
