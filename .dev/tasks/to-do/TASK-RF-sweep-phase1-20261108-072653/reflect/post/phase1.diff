+def test_run_id_with_a_semicolon_exits_2_before_any_orca_call(env):
+    _world(env)
+
+    result = _run(env, "--run", "r;x")
+
+    _failed(result, 2, "invalid --run value: r;x\n")
+    assert env.orca.calls == []
+    _nothing_written(env)
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
