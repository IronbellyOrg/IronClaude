+    hot = hot.split("## Phase 0", 1)[0]
+    verification, tail = hot.split("- If compatible and eligible,", 1)
+    binding, rejection = tail.split("- If the hint is incompatible,", 1)
+    rejection = rejection.split('- `outcome: "native"`', 1)[0]
