+
+    def refuse(argv, cwd):
+        return (
+            result(
+                wc,
+                128,
+                "",
+                "fatal: contains modified or untracked files, use --force to delete it",
+            )
+            if argv[1:3] == ["worktree", "remove"]
+            else None
+        )
