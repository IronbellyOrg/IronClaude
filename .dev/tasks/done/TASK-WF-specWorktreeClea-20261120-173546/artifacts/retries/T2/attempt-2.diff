+def _env(runner, argv, monkeypatch):
+    monkeypatch.setenv("GH_TOKEN", "placeholder-not-a-secret")
+    monkeypatch.setenv("GITHUB_TOKEN", "placeholder-not-a-secret")
+    return runner._env_for(argv)
