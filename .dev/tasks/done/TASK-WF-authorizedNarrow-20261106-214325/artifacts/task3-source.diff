+def json_object(pairs):
+    value = {}
+    for key, item in pairs:
+        if key in value:
+            raise ValueError('duplicate JSON field')
+        value[key] = item
+    return value
+
+
+def json_constant(value):
+    raise ValueError('non-JSON constant')
+
