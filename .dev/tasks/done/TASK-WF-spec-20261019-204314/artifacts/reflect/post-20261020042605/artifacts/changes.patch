+        else:
+            if _read_acquisition_receipt() != previous:
+                raise ValueError("Acquisition receipt changed concurrently")
+            os.replace(staged_path, _receipt_path())
+    finally:
+        if staged_path is not None:
+            staged_path.unlink(missing_ok=True)
