+def _flag_clear_matcher(path: Path) -> str:
+    data = json.loads(path.read_text())
+    for entry in data["hooks"]["PostToolUse"]:
+        for h in entry.get("hooks", []):
+            if "auggie-flag-clear" in h.get("command", ""):
+                return entry.get("matcher", "")
+    return ""
+
