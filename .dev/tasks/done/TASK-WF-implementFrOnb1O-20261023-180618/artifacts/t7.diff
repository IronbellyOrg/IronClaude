+# FR-ONB.1 (default planner): /sc:workflow is the default for planned work and
+# /task-builder is reserved for level 4. The old tie-break ("choose the heavier
+# one" with no level 3 versus 4 exception) and the old hard limit ("level 4 for
+# anything larger, longer, or riskier") pushed agents to /task-builder. They are
+# copied into the core CLAUDE.md, the sc-recommend skill, its plugin copies and
+# the /sc:recommend CLI prompt, so the check scans every .md and .py file under
+# src/ and plugins/.
+_TIE_BREAK = "choose the heavier one"
+_TIE_BREAK_EXCEPTION = "unsure between levels 3 and 4"
+_OLD_HARD_LIMIT = "larger, longer, or riskier"
+_LEVEL_4_SIZE_TRIGGERS = ("many files", "more than one session")
+
+
+def _default_planner_errors(text: str) -> list[str]:
+    errors = []
+    for n, line in enumerate(text.splitlines(), 1):
+        if _TIE_BREAK in line and _TIE_BREAK_EXCEPTION not in line:
+            errors.append(f"line {n}: tie-break without the level 3 versus 4 exception")
+        if _OLD_HARD_LIMIT in line:
+            errors.append(f"line {n}: old hard limit sends larger work to level 4")
+    return errors
+
+
+def _level_4_trigger_errors(level_block: str) -> list[str]:
+    rows = [r for r in _table_rows(level_block) if _cells(r)[0].startswith("**4.")]
+    assert len(rows) == 1, "level table must have exactly one level 4 row"
+    use_when = _cells(rows[0])[1]
+    return [
+        f"level 4 'Use this when' lists {phrase!r}"
+        for phrase in _LEVEL_4_SIZE_TRIGGERS
+        if phrase in use_when
+    ]
+
+
+def test_default_planner_wording_holds_in_src_and_plugins():
+    errors = []
+    for root in (_REPO / "src", _REPO / "plugins"):
+        for path in sorted(root.rglob("*")):
+            if path.suffix not in (".md", ".py") or not path.is_file():
+                continue
+            rel = path.relative_to(_REPO)
+            errors += [
+                f"{rel}: {e}"
+                for e in _default_planner_errors(path.read_text(encoding="utf-8"))
+            ]
+    assert not errors, errors
+
+
+def test_level_4_is_not_triggered_by_size_alone():
+    assert not _level_4_trigger_errors(_block(_text(), _LEVEL_BEGIN, _LEVEL_END))
+
+
+def test_default_planner_checks_catch_the_old_wording():
+    old_tie_break = "If you are unsure between two rows, choose the heavier one."
+    old_hard_limit = (
+        "level 3 for a few files with clear scope, "
+        "level 4 for anything larger, longer, or riskier."
+    )
+    assert _default_planner_errors(old_tie_break)
+    assert _default_planner_errors(old_hard_limit)
+    new_tie_break = (
+        "If you are unsure between levels 3 and 4, choose level 3. If you are "
+        "unsure between any other two rows, choose the heavier one."
+    )
+    assert not _default_planner_errors(new_tie_break)
+    old_level_block = (
+        "| Level | Use this when | What you run | What you end up with |\n"
+        "|---|---|---|---|\n"
+        "| **4. Build and run a task file** | The work touches many files, will take "
+        "more than one session, or must not drift from what was agreed. | x | y |\n"
+    )
+    assert len(_level_4_trigger_errors(old_level_block)) == 2
