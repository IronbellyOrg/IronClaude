@@ -0,0 +1,166 @@
+"""`superclaude review verify-citations`: deterministic, advisory pre-check of the findings-v2 citations of reviewer cards.
+
+For every citation of every parsed finding it reads the cited file (under --root, and only when the path is in the
+input snapshot) and records at most one flag:
+- missing-file: the path is not in the snapshot, resolves outside --root, or cannot be read;
+- out-of-range: line_end is past the last line of the file;
+- quote-not-found: the citation has a quote and it is not in the cited lines (whitespace-normalised); advisory,
+  because a failed locate is not proof that the citation is unfounded.
+
+It writes <out>/panel/precheck.json, with a `reread_set` listing every flagged citation (the evidence validator
+re-reads them even when its sampling would skip them). It spends no model tokens, drops nothing, and neither
+modifies a card nor writes anything else. The validator alone decides drops.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import click
+
+from superclaude.cli.review import cluster_cmd as cc
+from superclaude.cli.review import findings_v2 as fv2
+
+SCHEMA = "review-precheck/1"
+
+
+def _norm(text: str) -> str:
+    return " ".join(text.split())
+
+
+def _snapshot_paths(entries: list) -> set[str]:
+    out = set()
+    for e in entries:
+        if isinstance(e, str):
+            out.add(e)
+        elif isinstance(e, dict) and isinstance(e.get("path"), str):
+            out.add(e["path"])
+    return out
+
+
+def _check(
+    citation: dict, snapshot: set[str], root: Path, cache: dict
+) -> tuple[str | None, str | None]:
+    """(flag, reason) for one citation; (None, None) when it checks out."""
+    path = citation["path"]
+    if path not in snapshot:
+        return "missing-file", "not-in-snapshot"
+    if path not in cache:
+        try:
+            target = (root / path).resolve()
+            if root != target and root not in target.parents:
+                cache[path] = ("outside-root", None)
+            else:
+                cache[path] = (
+                    "ok",
+                    target.read_text(encoding="utf-8", errors="replace").splitlines(),
+                )
+        except OSError:
+            cache[path] = ("unreadable", None)
+    state, lines = cache[path]
+    if state == "outside-root":
+        return "missing-file", "outside-root"
+    if state == "unreadable":
+        return "missing-file", "not-readable"
+    if citation["line_end"] > len(lines):
+        return "out-of-range", f"file has {len(lines)} lines"
+    quote = citation.get("quote")
+    if quote and _norm(quote) not in _norm(
+        " ".join(lines[citation["line_start"] - 1 : citation["line_end"]])
+    ):
+        return "quote-not-found", "quote is not in the cited lines"
+    return None, None
+
+
+@click.command(name="verify-citations")
+@click.option(
+    "--cards",
+    "cards_dir",
+    required=True,
+    type=click.Path(exists=True, file_okay=False),
+    help="Directory of reviewer cards (*.md with a findings-v2 block).",
+)
+@click.option(
+    "--snapshot",
+    "snapshot",
+    required=True,
+    type=click.Path(exists=True, dir_okay=False),
+    help="artifacts/input-snapshot.yaml; only its paths are read.",
+)
+@click.option(
+    "--root",
+    "root",
+    default=".",
+    show_default=True,
+    type=click.Path(exists=True, file_okay=False),
+    help="Repository root: the base for reads.",
+)
+@click.option(
+    "--out",
+    "out",
+    required=True,
+    type=click.Path(file_okay=False),
+    help="Output directory; the result goes to <out>/panel/precheck.json.",
+)
+def command(cards_dir, snapshot, root, out) -> None:
+    """Flag citations whose file is missing, whose lines are out of range or whose quote is not found (advisory)."""
+    cards = sorted(Path(cards_dir).glob("*.md"))
+    if not cards:
+        raise click.ClickException(f"no *.md cards in {cards_dir}")
+    snap = _snapshot_paths(cc._snapshot_files(Path(snapshot)))
+    base = Path(root).resolve()
+    cache: dict = {}
+    rows, listing = [], []
+    for card in cards:
+        block = fv2.parse_block(cc._read(card, "card"))
+        rid = card.stem
+        listing.append(
+            {"card": card.name, "reviewer_id": rid, "block_state": block["state"]}
+        )
+        for f in block["findings"]:
+            for i, c in enumerate(f.get("citations") or [], 1):
+                if fv2._check_citation(c) is not None:
+                    continue  # a malformed citation cannot be read; the block checker reports it
+                flag, reason = _check(c, snap, base, cache)
+                rows.append(
+                    {
+                        "reviewer_id": rid,
+                        "finding_id": f["id"],
+                        "citation": i,
+                        "role": c["role"],
+                        "path": c["path"],
+                        "line_start": c["line_start"],
+                        "line_end": c["line_end"],
+                        "flag": flag,
+                        "reason": reason,
+                        "advisory": flag == "quote-not-found",
+                    }
+                )
+    flagged = [r for r in rows if r["flag"]]
+    result = {
+        "schema": SCHEMA,
+        "cards": listing,
+        "citations": rows,
+        "checked": len(rows),
+        "flagged": len(flagged),
+        "by_flag": {
+            k: sum(1 for r in flagged if r["flag"] == k)
+            for k in ("missing-file", "out-of-range", "quote-not-found")
+        },
+        "reread_set": [
+            {k: r[k] for k in ("reviewer_id", "finding_id", "citation", "path", "flag")}
+            for r in flagged
+        ],
+    }
+    target = Path(out) / "panel" / "precheck.json"
+    target.parent.mkdir(parents=True, exist_ok=True)
+    target.write_text(
+        json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+    )
+    click.echo(
+        json.dumps(
+            {"written": str(target), "checked": len(rows), "flagged": len(flagged)},
+            sort_keys=True,
+        )
+    )
diff --git a/tests/review/test_review_verify_citations.py b/tests/review/test_review_verify_citations.py
new file mode 100644
index 000000000..d055c5949
--- /dev/null
+++ b/tests/review/test_review_verify_citations.py
@@ -0,0 +1,170 @@
+"""`superclaude review verify-citations`: advisory flags, the re-read set, and nothing dropped."""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+from click.testing import CliRunner
+
+from superclaude.cli.main import main
+
+
+def _line(fid, path, start, end, quote=None):
+    cit = {"role": "source", "path": path, "line_start": start, "line_end": end}
+    if quote:
+        cit["quote"] = quote
+    return json.dumps(
+        {
+            "id": fid,
+            "severity": "MAJOR",
+            "blocking": True,
+            "category": "other",
+            "claim": f"claim {fid}",
+            "refs": ["R-1"],
+            "citations": [cit],
+        }
+    )
+
+
+def _card(*lines):
+    return (
+        "card\n\n## Findings block\n\n```findings-v2\n" + "\n".join(lines) + "\n```\n"
+    )
+
+
+@pytest.fixture
+def repo(tmp_path):
+    root = tmp_path / "repo"
+    (root / "src").mkdir(parents=True)
+    (root / "src/a.py").write_text(
+        "alpha beta gamma delta\nsecond line here\nthird line\n"
+    )
+    outside = tmp_path / "secret.txt"
+    outside.write_text("x\n")
+    (root / "src/link.txt").symlink_to(outside)
+    cards = tmp_path / "cards"
+    cards.mkdir()
+    (cards / "r1.md").write_text(
+        _card(
+            _line("OK", "src/a.py", 1, 2, "alpha beta gamma delta"),
+            _line("NOFILE", "src/nope.py", 1, 1),
+            _line("RANGE", "src/a.py", 2, 9),
+            _line("QUOTE", "src/a.py", 1, 1, "words that are not in the file"),
+            _line("OUTSIDE", "src/link.txt", 1, 1),
+        )
+    )
+    (cards / "r2.md").write_text(_card(_line("UNLISTED", "src/other.py", 1, 1)))
+    snap = tmp_path / "input-snapshot.yaml"
+    snap.write_text(
+        "file_list:\n  - path: src/a.py\n  - path: src/nope.py\n  - path: src/link.txt\n"
+    )
+    return tmp_path, root
+
+
+def _run(tmp, root, out="out"):
+    return CliRunner().invoke(
+        main,
+        [
+            "review", "verify-citations", "--cards", str(tmp / "cards"),
+            "--snapshot", str(tmp / "input-snapshot.yaml"), "--root", str(root),
+            "--out", str(tmp / out),
+        ],
+    )  # fmt: skip
+
+
+def _result(tmp, out="out"):
+    return json.loads((tmp / out / "panel/precheck.json").read_text())
+
+
+def _by_id(result):
+    return {(r["reviewer_id"], r["finding_id"]): r for r in result["citations"]}
+
+
+def test_each_flag_and_a_clean_citation(repo):
+    tmp, root = repo
+    res = _run(tmp, root)
+    assert res.exit_code == 0, res.output
+    rows = _by_id(_result(tmp))
+    assert rows[("r1", "OK")]["flag"] is None
+    assert rows[("r1", "NOFILE")]["flag"] == "missing-file"
+    assert rows[("r1", "RANGE")]["flag"] == "out-of-range"
+    quote = rows[("r1", "QUOTE")]
+    assert quote["flag"] == "quote-not-found" and quote["advisory"] is True
+    assert rows[("r1", "NOFILE")]["advisory"] is False
+    assert rows[("r1", "RANGE")]["advisory"] is False
+
+
+def test_path_outside_the_snapshot_or_the_root_is_missing_file(repo):
+    tmp, root = repo
+    _run(tmp, root)
+    rows = _by_id(_result(tmp))
+    assert rows[("r2", "UNLISTED")]["flag"] == "missing-file"
+    assert rows[("r2", "UNLISTED")]["reason"] == "not-in-snapshot"
+    assert rows[("r1", "OUTSIDE")]["flag"] == "missing-file"
+    assert rows[("r1", "OUTSIDE")]["reason"] == "outside-root"
+
+
+def test_reread_set_lists_every_flagged_citation(repo):
+    tmp, root = repo
+    _run(tmp, root)
+    result = _result(tmp)
+    flagged = {
+        (r["reviewer_id"], r["finding_id"]) for r in result["citations"] if r["flag"]
+    }
+    assert flagged == {("r1", f) for f in ("NOFILE", "RANGE", "QUOTE", "OUTSIDE")} | {
+        ("r2", "UNLISTED")
+    }
+    assert {
+        (r["reviewer_id"], r["finding_id"]) for r in result["reread_set"]
+    } == flagged
+    assert result["flagged"] == 5 and result["checked"] == 6
+    assert result["by_flag"] == {
+        "missing-file": 3,
+        "out-of-range": 1,
+        "quote-not-found": 1,
+    }
+
+
+def _keys(obj):
+    if isinstance(obj, dict):
+        for k, v in obj.items():
+            yield k
+            yield from _keys(v)
+    elif isinstance(obj, list):
+        for v in obj:
+            yield from _keys(v)
+
+
+def test_nothing_is_dropped_and_no_card_changes(repo):
+    tmp, root = repo
+    before = {p.name: p.read_bytes() for p in (tmp / "cards").iterdir()}
+    _run(tmp, root)
+    assert not [k for k in _keys(_result(tmp)) if "drop" in k]
+    assert {p.name: p.read_bytes() for p in (tmp / "cards").iterdir()} == before
+    assert sorted(p.name for p in (tmp / "out").rglob("*") if p.is_file()) == [
+        "precheck.json"
+    ]
+
+
+def test_running_twice_is_byte_identical(repo):
+    tmp, root = repo
+    _run(tmp, root)
+    first = (tmp / "out/panel/precheck.json").read_bytes()
+    _run(tmp, root)
+    assert (tmp / "out/panel/precheck.json").read_bytes() == first
+
+
+def test_empty_cards_dir_is_an_error(repo):
+    tmp, root = repo
+    (tmp / "empty").mkdir()
+    res = CliRunner().invoke(
+        main,
+        ["review", "verify-citations", "--cards", str(tmp / "empty"), "--snapshot", str(tmp / "input-snapshot.yaml"), "--out", str(tmp / "o")],
+    )  # fmt: skip
+    assert res.exit_code != 0 and "no *.md cards" in res.output
+
+
+def test_review_help_lists_verify_citations():
+    res = CliRunner().invoke(main, ["review", "--help"])
+    assert res.exit_code == 0 and "verify-citations" in res.output
