@@ -0,0 +1,176 @@
+"""`superclaude review cluster`: cluster the findings of calibrated reviewer cards (K4 cluster_v2).
+
+Cards are the `*.md` files of CARDS_DIR, in file-name order; the file stem is the reviewer id. Each card holds a
+`## Findings block` with a findings-v2 block and, optionally, a `calibration:` mapping with `per_finding`
+({finding id: confidence or {finding_confidence: confidence}}) in a fenced yaml block or as an unfenced
+`calibration:` block. A `--calibration` JSON sidecar {reviewer_id: {finding id: confidence}} overrides the
+embedded values of the reviewers it names.
+
+Without --kept it writes <out>/panel/clusters.json. With --kept (one finding id per line, or
+`reviewer_id:finding_id` to pin one reviewer) it writes <out>/panel/clusters_kept.json (the clusters_kept pass)
+and leaves clusters.json alone. A card whose block is not valid is listed as invalid under `cards` and is left
+out of the agreement. Cards are never modified and nothing else is written.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from pathlib import Path
+
+import click
+import yaml
+
+from superclaude.cli.review import card_convert as cc
+from superclaude.cli.review import findings_v2 as fv2
+
+_FENCE = re.compile(r"```[ \t]*ya?ml[ \t]*\n(.*?)\n[ \t]*```", re.S | re.I)
+_BARE = re.compile(r"^calibration:[ \t]*\n((?:[ \t]+\S.*(?:\n|$)|[ \t]*\n)+)", re.M)
+
+
+def _embedded_calibration(text: str) -> dict:
+    """{finding id: confidence} from the first `calibration.per_finding` mapping found in the card text."""
+    sources = [m.group(1) for m in _FENCE.finditer(text)]
+    sources += ["calibration:\n" + m.group(1) for m in _BARE.finditer(text)]
+    for src in sources:
+        try:
+            doc = yaml.safe_load(src)
+        except yaml.YAMLError:
+            continue
+        cal = doc.get("calibration") if isinstance(doc, dict) else None
+        per = cal.get("per_finding") if isinstance(cal, dict) else None
+        if isinstance(per, dict):
+            return {
+                str(k): (v.get("finding_confidence") if isinstance(v, dict) else v)
+                for k, v in per.items()
+            }
+    return {}
+
+
+def _read(path: Path, what: str) -> str:
+    try:
+        return path.read_text(encoding="utf-8", errors="replace")
+    except OSError as exc:
+        raise click.ClickException(f"cannot read {what} {path}: {exc}") from exc
+
+
+def _snapshot_files(path: Path) -> list:
+    try:
+        data = yaml.safe_load(_read(path, "snapshot"))
+    except yaml.YAMLError as exc:
+        raise click.ClickException(f"{path} is not valid YAML: {exc}") from exc
+    return cc._snapshot_entries(data)
+
+
+def _sidecar(path: Path) -> dict:
+    try:
+        data = json.loads(_read(path, "calibration sidecar"))
+    except json.JSONDecodeError as exc:
+        raise click.ClickException(f"{path} is not valid JSON: {exc}") from exc
+    if not isinstance(data, dict):
+        raise click.ClickException(
+            f"{path} must hold {{reviewer_id: {{finding_id: confidence}}}}"
+        )
+    return data
+
+
+def _kept_pairs(path: Path, blocks: dict[str, dict]) -> list[tuple[str, str]]:
+    pairs: list[tuple[str, str]] = []
+    for raw in _read(path, "kept file").splitlines():
+        entry = raw.strip()
+        if not entry or entry.startswith("#"):
+            continue
+        rid, sep, fid = entry.rpartition(":")
+        if sep:
+            pairs.append((rid, fid))
+            continue
+        pairs += [
+            (r, f["id"])
+            for r, b in blocks.items()
+            for f in b["findings"]
+            if isinstance(f, dict) and f.get("id") == entry
+        ]
+    return pairs
+
+
+@click.command(name="cluster")
+@click.argument("cards_dir", type=click.Path(exists=True, file_okay=False))
+@click.option(
+    "--snapshot",
+    "snapshot",
+    required=True,
+    type=click.Path(exists=True, dir_okay=False),
+    help="artifacts/input-snapshot.yaml (its file_list gives the resolvable paths).",
+)
+@click.option(
+    "--calibration",
+    "calibration",
+    default=None,
+    type=click.Path(exists=True, dir_okay=False),
+    help="JSON sidecar {reviewer_id: {finding_id: finding_confidence}}.",
+)
+@click.option(
+    "--kept",
+    "kept",
+    default=None,
+    type=click.Path(exists=True, dir_okay=False),
+    help="Finding ids the evidence validator kept, one per line (or reviewer_id:finding_id); writes clusters_kept.json.",
+)
+@click.option(
+    "--out",
+    "out",
+    required=True,
+    type=click.Path(file_okay=False),
+    help="Output directory; the result goes to <out>/panel/.",
+)
+def command(cards_dir, snapshot, calibration, kept, out) -> None:
+    """Cluster the findings of calibrated reviewer cards; print where the result was written."""
+    # Imported here so that loading the `review` group does not load cluster.py (other review commands stay unaffected).
+    from superclaude.cli.review import cluster as cl
+
+    cards = sorted(Path(cards_dir).glob("*.md"))
+    if not cards:
+        raise click.ClickException(f"no *.md cards in {cards_dir}")
+    side = _sidecar(Path(calibration)) if calibration else {}
+    records, blocks, listing = [], {}, []
+    for ordinal, card in enumerate(cards, 1):
+        text = _read(card, "card")
+        block = fv2.parse_block(text)
+        rid = card.stem
+        cal = side.get(rid) if isinstance(side.get(rid), dict) else None
+        records.append((rid, ordinal, block, cal or _embedded_calibration(text)))
+        blocks[rid] = block
+        listing.append(
+            {
+                "card": card.name,
+                "reviewer_id": rid,
+                "state": "complete" if block["state"] == "complete" else "invalid",
+                "block_state": block["state"],
+                "errors": block["errors"],
+            }
+        )
+    files = _snapshot_files(Path(snapshot))
+    if kept:
+        result = cl.clusters_kept(records, files, _kept_pairs(Path(kept), blocks))
+        name = "clusters_kept.json"
+    else:
+        result = cl.cluster_v2(records, files)
+        name = "clusters.json"
+    result = {**result, "cards": listing}
+    target = Path(out) / "panel" / name
+    target.parent.mkdir(parents=True, exist_ok=True)
+    target.write_text(
+        json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+    )
+    click.echo(
+        json.dumps(
+            {
+                "written": str(target),
+                "cluster_agreement": result["cluster_agreement"],
+                "invalid": [
+                    c["reviewer_id"] for c in listing if c["state"] != "complete"
+                ],
+            },
+            sort_keys=True,
+        )
+    )
diff --git a/tests/review/test_review_cluster_cmd.py b/tests/review/test_review_cluster_cmd.py
new file mode 100644
index 000000000..e0e829af2
--- /dev/null
+++ b/tests/review/test_review_cluster_cmd.py
@@ -0,0 +1,198 @@
+"""`superclaude review cluster`: clusters.json, clusters_kept.json, invalid cards, determinism."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+from click.testing import CliRunner
+
+from superclaude.cli.main import main
+
+
+def _line(fid, path, start, end, refs, blocking=True):
+    return json.dumps(
+        {
+            "id": fid,
+            "severity": "MAJOR" if blocking else "MINOR",
+            "blocking": blocking,
+            "category": "other",
+            "claim": f"claim {fid}",
+            "refs": refs,
+            "citations": [
+                {"role": "plan", "path": path, "line_start": start, "line_end": end}
+            ],
+        }
+    )
+
+
+def _card(lines, calibration=None, fenced=True):
+    text = (
+        "review card\n\n## Findings block\n\n```findings-v2\n"
+        + "\n".join(lines)
+        + "\n```\n"
+    )
+    if calibration is not None:
+        body = "calibration:\n  per_finding:\n" + "".join(
+            f"    {k}: {{finding_confidence: {v}}}\n" for k, v in calibration.items()
+        )
+        text += "\n```yaml\n" + body + "```\n" if fenced else "\n" + body
+    return text
+
+
+@pytest.fixture
+def run_dir(tmp_path):
+    cards = tmp_path / "cards"
+    cards.mkdir()
+    (cards / "r1.md").write_text(
+        _card(
+            [
+                _line("F1", "plan.md", 10, 12, ["R-1"]),
+                _line("F2", "plan.md", 40, 41, ["R-2"]),
+            ],
+            {"F1": 0.9, "F2": 0.8},
+        )
+    )
+    (cards / "r2.md").write_text(
+        _card([_line("G1", "plan.md", 11, 12, ["R-1"])], {"G1": 0.7})
+    )
+    snap = tmp_path / "input-snapshot.yaml"
+    snap.write_text("file_list:\n  - path: plan.md\n    sha256: abc\n")
+    return tmp_path
+
+
+def _run(run_dir, *extra, out="out"):
+    args = [
+        "review", "cluster", str(run_dir / "cards"),
+        "--snapshot", str(run_dir / "input-snapshot.yaml"),
+        "--out", str(run_dir / out), *extra,
+    ]  # fmt: skip
+    return CliRunner().invoke(main, args)
+
+
+def _members(result):
+    return sorted(
+        (m["reviewer_id"], m["id"]) for c in result["clusters"] for m in c["members"]
+    )
+
+
+def test_two_cards_write_clusters_with_the_agreement(run_dir):
+    res = _run(run_dir)
+    assert res.exit_code == 0, res.output
+    data = json.loads((run_dir / "out/panel/clusters.json").read_text())
+    assert _members(data) == [("r1", "F1"), ("r1", "F2"), ("r2", "G1")]
+    assert len(data["clusters"]) == 2
+    # cluster {F1, G1}: support 1.0; cluster {F2}: 0.8 / 1.6 = 0.5; mean 0.75
+    assert data["cluster_agreement"] == 0.75
+    assert json.loads(res.output)["cluster_agreement"] == 0.75
+    assert [c["state"] for c in data["cards"]] == ["complete", "complete"]
+    assert not (run_dir / "out/panel/clusters_kept.json").exists()
+
+
+def test_kept_pass_drops_unkept_ids_and_leaves_clusters_json_alone(run_dir):
+    _run(run_dir)
+    clusters = run_dir / "out/panel/clusters.json"
+    before = clusters.read_bytes()
+    kept = run_dir / "kept.txt"
+    kept.write_text("F1\nG1\n")
+    res = _run(run_dir, "--kept", str(kept))
+    assert res.exit_code == 0, res.output
+    assert clusters.read_bytes() == before
+    data = json.loads((run_dir / "out/panel/clusters_kept.json").read_text())
+    assert _members(data) == [("r1", "F1"), ("r2", "G1")]
+    assert data["cluster_agreement"] == 1.0
+    first = (run_dir / "out/panel/clusters_kept.json").read_bytes()
+    _run(run_dir, "--kept", str(kept))
+    assert (run_dir / "out/panel/clusters_kept.json").read_bytes() == first
+    assert clusters.read_bytes() == before
+
+
+def test_running_twice_is_byte_identical(run_dir):
+    _run(run_dir)
+    first = (run_dir / "out/panel/clusters.json").read_bytes()
+    _run(run_dir)
+    assert (run_dir / "out/panel/clusters.json").read_bytes() == first
+    assert sorted(p.name for p in (run_dir / "out").rglob("*") if p.is_file()) == [
+        "clusters.json"
+    ]
+
+
+def test_kept_line_can_pin_one_reviewer(run_dir):
+    (run_dir / "cards/r2.md").write_text(
+        _card([_line("F1", "plan.md", 11, 12, ["R-1"])], {"F1": 0.7})
+    )
+    kept = run_dir / "kept.txt"
+    kept.write_text("# validator output\nr1:F1\nr1:F2\n")
+    assert _run(run_dir, "--kept", str(kept)).exit_code == 0
+    data = json.loads((run_dir / "out/panel/clusters_kept.json").read_text())
+    assert _members(data) == [("r1", "F1"), ("r1", "F2")]
+
+
+def test_invalid_card_is_reported_and_left_out_of_the_agreement(run_dir):
+    (run_dir / "cards/bad.md").write_text(
+        "card\n\n## Findings block\n\n```findings-v2\n{not json\n```\n"
+    )
+    res = _run(run_dir)
+    assert res.exit_code == 0, res.output
+    data = json.loads((run_dir / "out/panel/clusters.json").read_text())
+    bad = next(c for c in data["cards"] if c["reviewer_id"] == "bad")
+    assert bad["state"] == "invalid" and bad["errors"]
+    assert data["invalid_reviewers"] == ["bad"]
+    assert data["complete_reviewers"] == ["r1", "r2"]
+    assert data["cluster_agreement"] == 0.75
+    assert json.loads(res.output)["invalid"] == ["bad"]
+
+
+def test_a_card_with_no_findings_block_is_invalid_not_a_crash(run_dir):
+    (run_dir / "cards/none.md").write_text("just prose\n")
+    res = _run(run_dir)
+    assert res.exit_code == 0, res.output
+    assert json.loads(res.output)["invalid"] == ["none"]
+
+
+def test_fewer_than_two_valid_blocks_gives_null_agreement(run_dir):
+    (run_dir / "cards/r2.md").write_text("no block\n")
+    assert _run(run_dir).exit_code == 0
+    data = json.loads((run_dir / "out/panel/clusters.json").read_text())
+    assert data["cluster_agreement"] is None
+
+
+def test_sidecar_and_unfenced_calibration(run_dir):
+    (run_dir / "cards/r1.md").write_text(
+        _card(
+            [
+                _line("F1", "plan.md", 10, 12, ["R-1"]),
+                _line("F2", "plan.md", 40, 41, ["R-2"]),
+            ],
+            {"F1": 0.9, "F2": 0.8},
+            fenced=False,
+        )
+    )
+    (run_dir / "cards/r2.md").write_text(
+        _card([_line("G1", "plan.md", 11, 12, ["R-1"])])
+    )
+    side = run_dir / "cal.json"
+    side.write_text(json.dumps({"r2": {"G1": 0.7}}))
+    assert _run(run_dir, "--calibration", str(side)).exit_code == 0
+    data = json.loads((run_dir / "out/panel/clusters.json").read_text())
+    assert data["cluster_agreement"] == 0.75 and data["uncalibrated"] == []
+
+
+def test_cards_are_not_modified_and_an_empty_dir_is_an_error(run_dir):
+    before = {p.name: p.read_bytes() for p in (run_dir / "cards").iterdir()}
+    _run(run_dir)
+    assert {p.name: p.read_bytes() for p in (run_dir / "cards").iterdir()} == before
+    empty = run_dir / "empty"
+    empty.mkdir()
+    res = CliRunner().invoke(
+        main,
+        ["review", "cluster", str(empty), "--snapshot", str(run_dir / "input-snapshot.yaml"), "--out", str(run_dir / "o2")],
+    )  # fmt: skip
+    assert res.exit_code != 0 and "no *.md cards" in res.output
+    assert not Path(run_dir / "o2").exists()
+
+
+def test_review_help_lists_cluster():
+    res = CliRunner().invoke(main, ["review", "--help"])
+    assert res.exit_code == 0 and "cluster" in res.output
