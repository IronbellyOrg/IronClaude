+def default_out(root: Path) -> Path:
+    package = root / ".dev" / "tasks" / "to-do" / PLAN_ID
+    return (
+        package / "artifacts" / "stage0a-report.md"
+        if package.is_dir()
+        else Path("artifacts") / "stage0a-report.md"
+    )
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument(
+        "--root",
+        type=Path,
+        default=Path(__file__).resolve().parent.parent,
+        help="repository root",
+    )
+    parser.add_argument(
+        "--out",
+        type=Path,
+        default=None,
+        help="report file (default: the plan package artifact)",
+    )
+    args = parser.parse_args(argv)
+    root = args.root.resolve()
+    out = args.out or default_out(root)
+    data = collect(root)
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(render(data), encoding="utf-8")
+    s = data["summary"]
+    verdict = "PASS" if s["share"] is not None and s["share"] >= GATE else "FAIL"
+    print(f"wrote {out}")
+    print(
+        f"cards={s['cards']} units={s['units']} converted={s['converted']} share={_pct(s['share'])} gate={verdict}"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
