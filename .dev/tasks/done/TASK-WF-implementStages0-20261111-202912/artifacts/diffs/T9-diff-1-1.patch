+    if len(reviewers) > _REFLECT_MAX_REVIEWERS:
+        errors.append(
+            f"a reflect resolution allows at most {_REFLECT_MAX_REVIEWERS} reviewers; got {len(reviewers)}"
+        )
+    for r in reviewers:
+        for m in [r["model"], *r["fallbacks"]]:
