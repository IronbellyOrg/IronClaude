+        "pair_id,cluster_v2_verdict,human_same_defect\n"
+        ",,\n"
+        "P01,merged,yes\n",
+        encoding="utf-8",
+    )
+    code, out, _ = _score(path, capsys)
+    assert "confusion: TP=1 FP=0 FN=0 TN=0" in out
+    assert code == 1  # one row is fewer than 50
