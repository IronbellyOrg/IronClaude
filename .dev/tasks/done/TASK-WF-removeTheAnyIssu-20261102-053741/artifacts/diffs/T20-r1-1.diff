+# --- (e) / (j) edit-table rows hold ----------------------------------------
+
+
+def _failing_rows(fixture: str) -> list[str]:
+    bad = []
+    for row in _rows(fixture):
+        text = _read(row["file"])
+        if row["old"] in text or row["new"] not in text:
+            bad.append(f"{row['id']} {row['file']}")
+    return bad
+
