+
+# --- (g) shared verdict suffixes kept ---------------------------------------
+
+NO_CONDITIONAL_PASS = "Only PASS or FAIL — no conditional pass."
+
+
+@pytest.mark.parametrize(
+    "rel",
+    [
+        "src/superclaude/templates/documents/skill_template.md",
