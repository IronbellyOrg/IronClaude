+@contextmanager
+def _claim_active_output(output_dir):
+    if not output_dir:
+        yield
+        return
+    root = Path(output_dir).resolve()
+    with _ACTIVE_OUTPUTS_LOCK:
+        if root in _ACTIVE_OUTPUTS:
+            click.echo(
