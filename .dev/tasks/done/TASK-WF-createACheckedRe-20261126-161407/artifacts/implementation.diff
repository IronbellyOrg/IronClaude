+    if damage == "missing":
+        manifest.unlink()
+    elif damage == "malformed":
+        manifest.write_text("not JSON")
+    elif damage == "job":
+        args[1] = "wrong-job"
+    elif damage == "inventory":
+        # Slot zero may be retryable; duplicate an actually succeeded slot.
