+    before = _artifact_bytes(out)
+    constructed = []
+
+    def factory(*args, **kwargs):
+        def constructor(index):
+            constructed.append(index)
+            if index == 1:
+                raise RuntimeError("injected delayed transport constructor failure")
+            return StubTransport()
+
+        return constructor
