+    _retry_one(out)
+    real_dispatch = dispatch.dispatch_wave1
+    seen = []
+
+    def observe(*args, **kwargs):
+        before = _artifact_bytes(out)
+        alias = str(out / ".." / out.name)
+        inner = CliRunner().invoke(run_cmd, ["--resume", job_id, "--output", alias])
+        assert inner.exit_code != EXIT_OK
