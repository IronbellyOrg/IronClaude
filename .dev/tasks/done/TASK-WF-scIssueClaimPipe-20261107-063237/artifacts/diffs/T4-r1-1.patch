+4. After both comments are posted, run Wave 7. A STOP anywhere in Waves 0 to 6, including `E-POST-FAILED`, means no Orca call after the Wave 0 check. Do not stage or commit `.dev/issues/` (default D24).
+
+## Wave 7: worktree (orchestrator, no worker)
+
+Runs for every `--pipeline` value, after both comments are posted:
+
+`uv run --no-project python "<skill base>/scripts/orca_worktree.py" worktree --repo <R> --number <N> --base origin/<B> --source <D>`
+
+Read the one JSON object it prints: `status` (`created`, `reused` or `failed`), `path`, `branch`, `match_key`, `warning`, `detail`, `tracked_files` and `tracked_known`. Every failure is a warning, never a STOP: the assignment and the comments cannot be undone, so the claim `status` stays `success`. The script copies `<D>` into `<wt>/.dev/issues/<N>/` (it never copies `worktree.json`) and writes `<D>/worktree.json`. The skill itself runs no `git worktree` command and no other `orca` command here.
+
+Print, in this order:
+
+1. The `next-steps.md` path, then `Worktree: <path> (<status>, matched by <match_key>)`. For `match_key` `basename` or `branch` add "reused a worktree not created by /sc:issue". For `record` after `W-ORCA-LIST-FAILED` add "unverified: Orca could not be listed".
+2. "`.dev/issues/<N>/` in the worktree is untracked: do not stage it" only when `tracked_known` is true and `tracked_files` is empty. When `tracked_known` is false, print nothing about tracking.
+3. "run `make sync-dev` there first" when `<wt>/.claude/` is absent and a step of `next-steps.md` needs a primitive that is not synced into the worktree.
+4. The `warning` code, if any, then each other code in `detail`, each with its remedy line:
+
+| Code | Remedy line |
+|---|---|
+| `W-ORCA-LIST-FAILED` | check Orca, re-run the claim |
+| `W-ORIGIN-BASE-MISSING` | `git fetch origin`, re-run |
+| `W-ORIGIN-BASE-STALE` | `git fetch origin`, rebase in `<wt>` |
+| `W-WORKTREE-CREATE-FAILED` | re-run; a finished create is reused |
+| `W-WORKTREE-AMBIGUOUS` | remove the extra worktrees, re-run |
+| `W-WORKTREE-STALE` | `git worktree prune`, then `orca worktree rm` |
+| `W-WORKTREE-COPY-FAILED` | copy the named files by hand |
+
+Then print the return contract and STOP.
diff --git a/tests/skills/test_issue_protocol.py b/tests/skills/test_issue_protocol.py
index 7bb652e2..10c7aacb 100644
--- a/tests/skills/test_issue_protocol.py
+++ b/tests/skills/test_issue_protocol.py
@@ -215,6 +215,61 @@ def test_all_five_refs_exist():
     ]
 
 
+# --- the Orca worktree step (design pipeline-flag, ST-5 and ST-6) ----------------
+
+
+def _wave(text: str, number: int) -> str:
+    """The text of `## Wave <number>` up to the next `## ` heading."""
+    match = re.search(rf"^## Wave {number}\b.*?(?=^## |\Z)", text, re.M | re.S)
+    assert match, f"refs/claim.md has no Wave {number}"
+    return match.group(0)
+
+
+def test_st5_orca_script_is_named_in_the_files_table_and_exists():
+    rows = [ln for ln in _text(SKILL).splitlines() if ln.startswith("| `scripts/")]
+    assert any(ln.startswith("| `scripts/orca_worktree.py` |") for ln in rows)
+    assert (SKILL_DIR / "scripts/orca_worktree.py").is_file()
+    assert len(list(REFS.glob("*.md"))) == 5
+
+
+def test_st6_preflight_is_in_wave_0_and_worktree_is_wave_7_after_the_posts():
+    claim = _text(REFS / "claim.md")
+    wave0 = _wave(claim, 0)
+    assert 'orca_worktree.py" preflight' in wave0
+    assert "E-ORCA-REQUIRED" in wave0
+    assert wave0.index("gh auth status") < wave0.index("preflight")
+    assert wave0.index("preflight") < wave0.index("default branch")
+    assert claim.index("## Wave 0") < claim.index("## Wave 1")
+    assert claim.index("## Wave 6") < claim.index("## Wave 7")
+    wave6, wave7 = _wave(claim, 6), _wave(claim, 7)
+    assert "After both comments are posted, run Wave 7" in wave6
+    assert (
+        'orca_worktree.py" worktree --repo <R> --number <N> --base origin/<B>' in wave7
+    )
+    assert "--source <D>" in wave7
+    assert "never a STOP" in wave7
+    for code in (
+        "W-ORCA-LIST-FAILED",
+        "W-ORIGIN-BASE-MISSING",
+        "W-ORIGIN-BASE-STALE",
+        "W-WORKTREE-CREATE-FAILED",
+        "W-WORKTREE-AMBIGUOUS",
+        "W-WORKTREE-STALE",
+        "W-WORKTREE-COPY-FAILED",
+    ):
+        assert code in wave7 and code in _text(SKILL)
+
+
+def test_st6_skill_steps_name_the_orca_check_and_the_worktree_step():
+    skill = _text(SKILL)
+    claim_mode = skill.split("## Claim mode", 1)[1].split("## Create mode", 1)[0]
+    assert "E-ORCA-REQUIRED" in claim_mode and "preflight" in claim_mode
+    assert claim_mode.index("preflight") < claim_mode.index("**Wave 1, lookup.**")
+    assert "**Wave 7, worktree.**" in claim_mode
+    assert "Print the `next-steps.md` path and STOP" not in skill
+    assert "E-ORCA-REQUIRED" in skill.split("## Error handling", 1)[1]
+
+
