+class TestRunLock:
+    def test_run_lock_acquire_creates_file_with_payload(self, tmp_path: Path):
+        # Case 1: acquire creates the lockfile with a pid+payload.
+        path = acquire_run_lock(tmp_path)
+        try:
+            assert path == tmp_path / ".recovery-locks" / "run.lock"
+            assert path.exists()
