+    )
+    assert (
+        pair("`grep -c '^retry policy$' docs/ops.md` prints 1.", s).features["no_match"]
+        == 0
+    )
+    assert (
+        pair("`grep -c '^policy' docs/ops.md` prints 1.", s).features["no_match"] == 1
