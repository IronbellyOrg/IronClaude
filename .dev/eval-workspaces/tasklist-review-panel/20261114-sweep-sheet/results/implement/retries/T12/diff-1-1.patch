+
+
+def test_earlier_task_strings_are_used_and_the_goal_sees_every_task():
+    text = (
+        "Goal: `grep -c 'retry-policy' docs/ops.md` prints 1.\n\n"
+        f"## Task 1: Docs\n\n{ORDER_SENTENCE}\n\nAcceptance criteria:\n- The page exists.\n\n"
