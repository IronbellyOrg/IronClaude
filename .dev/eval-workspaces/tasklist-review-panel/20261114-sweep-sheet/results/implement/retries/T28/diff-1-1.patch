@@ -0,0 +1,31 @@
+# Redaction rules of the blind-judge anonymiser (step 0.6)
+
+Source read: `.dev/eval-workspaces/tasklist-review-panel/20261111-a1/tools/tmp-scripts/anon-b11.sh` (the script that made the
+`merged-anon.md` files of the earlier study). No ground-truth or score file was opened.
+
+## What anon-b11.sh does, in order
+
+1. Picks a random one-letter label from `Q R S T U V` that is not yet a folder under the combo, writes
+   `label-key.json` (`label`, `combo`) next to it and the report to `<label>/merged-anon.md`.
+2. Replaces the whole study root (`$EVAL`) with `<EVAL>` (`sed "s|$EVAL|<EVAL>|g"`).
+3. Finds reviewer ids with `\bt[0-9a-z]+-[0-9]+\b`, sorts them (`sort -u`) and replaces the k-th with `R<k>` with
+   `sed -i "s/\bID\b/R<k>/g"`.
+4. Blanks the path of the candidate line: `candidate: <EVAL>/.../candidate.md sha256` becomes
+   `candidate: <candidate file> sha256`.
+5. Blanks every report path of the reviewers list: `report <EVAL>/...` becomes `report <redacted>`.
+
+## What bin/anon.sh keeps, changes and adds
+
+| Rule | anon-b11.sh | bin/anon.sh |
+|---|---|---|
+| random label | one letter, six values | `j` plus six hex digits (16.7 million values), never an existing folder of the output root |
+| root paths | `$EVAL` only | the run folder, `SB`, `EVAL`, `SW` and `REPO`, each to `<RUN>`, `<SB>`, `<EVAL>`, `<SW>`, `<REPO>` (the run folder first, because it sits under `SW` or `/tmp`) |
+| candidate line | `candidate: <EVAL>/... sha256` only | any `candidate: ... sha256` line |
+| report paths | `report <EVAL>/...` | `report <RUN>...` (a path tagged by an earlier rule) and `report /...` |
+| reviewer ids | `t[0-9a-z]+-[0-9]+`, sorted, `R1..Rn` | `t[0-9]+[a-z]*-[0-9]+` plus every id named in the reviewers list, sorted, `R1..Rn`; word boundaries, so `test-1` is not an id |
+| key file | written in the combo folder (names the combo) | none: the caller (`bin/judge-batch.sh`) keeps the label-to-run key in the run folder, never in the scoring folder |
+
+## Why
+
+The judge reads `merged-anon.md` by a path that contains the label only, so the path names no arm, run, reviewer or model
+(REQ-43). Both the file name and the text must carry nothing the report itself does not already carry.
diff --git a/.dev/eval-workspaces/tasklist-review-panel/20261114-sweep-sheet/scaffold/judge.py b/.dev/eval-workspaces/tasklist-review-panel/20261114-sweep-sheet/scaffold/judge.py
new file mode 100644
index 000000000..9e6511f63
--- /dev/null
+++ b/.dev/eval-workspaces/tasklist-review-panel/20261114-sweep-sheet/scaffold/judge.py
@@ -0,0 +1,127 @@
+"""Judge-batch helpers (REQ-43, DESIGN 11.3, 14.3): the seeded second-judge sample and the audit of judge outputs.
+
+Standard library only. bin/judge-batch.sh runs it as a script:
+    judge.py sample SEED ID...    prints the ids of the second-judge sample, one per line
+    judge.py audit DIR...         prints the audit as JSON; exit 1 when any folder is bad
+A judge folder holds merged-anon.md (the report the judge saw), judge.json, judge.err, judge.started and score.json.
+"""
+
+import json
+import random
+import re
+import sys
+from pathlib import Path
+
+FRACTION = 0.15
+# The text of an Opus API error: the `result` of a failed call, or a line of its stderr.
+API_ERROR = re.compile(r"^\s*API Error\b", re.M)
+
+
+def sample(ids, seed, fraction=FRACTION):
+    """round(fraction * n) of the n distinct ids, drawn with a generator seeded by `seed`; sorted."""
+    ids = sorted(set(ids))
+    return sorted(random.Random(seed).sample(ids, round(fraction * len(ids))))
+
+
+def ledger_counts(text):
+    """(rows, blocking rows) of the `## Ledger` table of a merged report (columns: lid, status, blocking, ...)."""
+    rows = blocking = 0
+    inside = False
+    for line in text.splitlines():
+        if line.strip() == "## Ledger":
+            inside = True
+        elif inside and line.startswith("## "):
+            break
+        elif inside and line.startswith("|"):
+            cells = [c.strip() for c in line.strip().strip("|").split("|")]
+            if cells[0] == "lid" or not cells[0].strip("-: "):
+                continue  # the header and the separator row
+            rows += 1
+            blocking += len(cells) > 2 and cells[2] == "yes"
+    return rows, blocking
+
+
+def _is_api_error(node):
+    """True when a parsed judge.json carries `is_error: true` or a string that starts with `API Error`."""
+    if isinstance(node, dict):
+        return node.get("is_error") is True or any(
+            _is_api_error(v) for v in node.values()
+        )
+    if isinstance(node, list):
+        return any(_is_api_error(v) for v in node)
+    return isinstance(node, str) and API_ERROR.search(node) is not None
+
+
+def _load(path):
+    try:
+        return json.loads(path.read_text(encoding="utf-8")), True
+    except (OSError, ValueError):
+        return None, False
+
+
+def audit_one(folder):
+    """The problems of one judge folder (an empty list means clean)."""
+    d = Path(folder)
+    bad = []
+    jj = d / "judge.json"
+    if not jj.is_file():
+        bad.append("judge_missing")
+    else:
+        data, ok = _load(jj)
+        if not ok:
+            bad.append("judge_unparseable")
+        elif _is_api_error(data):
+            bad.append("api_error")
+    err = d / "judge.err"
+    if "api_error" not in bad and err.is_file():
+        if API_ERROR.search(err.read_text(encoding="utf-8", errors="replace")):
+            bad.append("api_error")
+    sc = d / "score.json"
+    if not sc.is_file():
+        bad.append("no_score")
+        return bad
+    score, ok = _load(sc)
+    if not ok or not isinstance(score, dict):
+        bad.append("score_unparseable")
+    else:
+        report = d / "merged-anon.md"
+        if not report.is_file():
+            bad.append("no_merged_report")
+        else:
+            rows = ledger_counts(report.read_text(encoding="utf-8"))
+            if (
+                score.get("ledger_rows_total"),
+                score.get("ledger_rows_blocking"),
+            ) != rows:
+                bad.append("rows_mismatch")
+    # A score file older than the start of this judge run is left over from an earlier run (the defect CR line 147 describes).
+    started = d / "judge.started"
+    if started.is_file() and sc.stat().st_mtime < started.stat().st_mtime:
+        bad.append("score_stale")
+    return bad
+
+
+def audit(folders):
+    items = []
+    for f in folders:
+        problems = audit_one(f)
+        if problems:
+            items.append({"dir": str(f), "problems": problems})
+    return {"checked": len(folders), "bad": len(items), "items": items}
+
+
+def main(argv):
+    if len(argv) >= 3 and argv[1] == "sample":
+        for i in sample(argv[3:], int(argv[2])):
+            print(i)
+        return 0
+    if len(argv) >= 2 and argv[1] == "audit":
+        result = audit(argv[2:])
+        print(json.dumps(result, indent=1))
+        return 1 if result["bad"] else 0
+    print("usage: judge.py sample SEED ID... | judge.py audit DIR...", file=sys.stderr)
+    return 2
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
