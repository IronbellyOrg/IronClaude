+    "set_completeness": SET_COMPLETENESS,
+    "set_universal": SET_UNIVERSAL,
+    "limiters": LIMITERS,
+    "edit_verbs": EDIT_VERBS,
+    "create_verbs": CREATE_VERBS,
+    "dictation_verbs": DICTATION_VERBS,
+    "ordering_verbs": ORDERING_VERBS,
+    "stop": STOP,
+}
