+def _span_hit(ctx: _Ctx, lo: int, hi: int, **extra):
+    t = _trim(ctx, lo, hi)
+    if not t:
+        return None
+    return {
+        "ls": t[0],
+        "le": t[1],
+        "text": "\n".join(ctx.lines[t[0] - 1 : t[1]]),
+        **extra,
+    }
