+def test_run_ids_name_arm_panel_document_and_replicate():
+    m = module()
+    assert m.run_id("1", "Z0-raw", "primary", "HO-1", 3) == "s1-z0raw-HO-1-r3"
+    assert m.run_id("2", "SS", "haiku", "HO-2", 1) == "s2-ss-haiku-HO-2-r1"
