+    assert (panels["S"]["cap"], panels["L1"]["cap"], panels["L2"]["cap"]) == (8, 8, 8)
+    ss = next(n for n in summary["started"] if "-ss-" in n)
+    assert json.loads((t / "runs-s" / ss / "prepass" / "assignment.json").read_text())[
