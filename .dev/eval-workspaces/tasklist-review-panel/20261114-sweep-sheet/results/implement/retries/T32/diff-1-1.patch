+
+def test_append_and_arguments_are_checked(tmp_path):
+    out = tmp_path / "s.tsv"
+    base = ["--stage", 1, "--docs", "HO-1", "--reps", 2, "--seed", 5]
+    assert make(*base, "--arms", "z0", "--out", out).returncode == 0
+    for args, text in (
+        ([*base, "--arms", "z0", "--append", out], "already in the schedule"),
+        (
+            [
+                "--stage",
+                1,
+                "--docs",
+                "HO-1",
+                "--reps",
