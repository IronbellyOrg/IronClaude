+"""User-facing /ai export handler.
+
+The handler is intentionally not registered with the production CLI, route
+table, registry, or [project.scripts] entrypoint in this fixture.
+"""
+
+from __future__ import annotations
+
+
+def handle_ai_export(request: dict[str, str]) -> dict[str, str]:
+    """Handle the /ai export action."""
+    export_id = request.get("export_id")
+    if not export_id:
+        return {"status": "error", "message": "export_id is required"}
+    return {"status": "ready", "surface": "/ai", "action": "export", "id": export_id}
+
+
+__all__ = ["handle_ai_export"]
