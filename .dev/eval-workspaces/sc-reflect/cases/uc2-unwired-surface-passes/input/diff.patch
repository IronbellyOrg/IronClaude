+"""Tests for the /ai Spawn handler.
+
+The test intentionally imports handle_ai_spawn directly; it does not prove the
+handler is reachable from the production CLI or any runtime entrypoint.
+"""
+
+from superclaude.cli.ai_spawn import handle_ai_spawn
+
+
+def test_handle_ai_spawn_queues_prompt() -> None:
+    assert handle_ai_spawn({"prompt": "summon"}) == {
+        "status": "queued",
+        "surface": "/ai",
+        "action": "Spawn",
+    }
+
+
+def test_handle_ai_spawn_requires_prompt() -> None:
+    assert handle_ai_spawn({})["status"] == "error"
