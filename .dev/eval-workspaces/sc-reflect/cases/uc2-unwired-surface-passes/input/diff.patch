+"""User-facing /ai Spawn handler.
+
+FR-S9-04 requires users to reach /ai and invoke Spawn. This module adds the
+surface handler but does not wire it into any production CLI, route, registry,
+or [project.scripts] entrypoint.
+"""
+
+from __future__ import annotations
+
+
+def handle_ai_spawn(request: dict[str, str]) -> dict[str, str]:
+    """Handle the /ai Spawn action for the user-facing surface."""
+    prompt = request.get("prompt", "")
+    if not prompt:
+        return {"status": "error", "message": "prompt is required"}
+    return {"status": "queued", "surface": "/ai", "action": "Spawn"}
+
+
+__all__ = ["handle_ai_spawn"]
