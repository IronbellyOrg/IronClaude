+"""Reachable /ai status runtime surface."""
+
+from __future__ import annotations
+
+
+def handle_ai_status(request: dict[str, str]) -> dict[str, str]:
+    """Handle the user-facing /ai status command."""
+    return {"status": "ok", "surface": "/ai", "action": "status"}
+
+
+def normalize_status_label(label: str) -> str:
+    """Pure internal helper; not a runtime surface."""
+    return label.strip().lower().replace(" ", "-")
+
+
+__all__ = ["handle_ai_status", "normalize_status_label"]
