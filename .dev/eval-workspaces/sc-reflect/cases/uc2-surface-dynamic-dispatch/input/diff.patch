+"""Tests for the dynamically-dispatched /ai Spawn handler.
+
+The test imports handle_spawn directly; it does not establish that any user can
+reach the handler through the production run_cli/dispatch path.
+"""
+
+from superclaude.cli.ai_spawn_dynamic import handle_spawn
+
+
+def test_handle_spawn_queues() -> None:
+    assert handle_spawn({}) == {"status": "queued", "surface": "/ai", "action": "Spawn"}
