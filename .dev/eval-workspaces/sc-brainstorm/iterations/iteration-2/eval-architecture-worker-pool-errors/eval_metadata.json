{
  "eval_id": 5,
  "eval_name": "architecture-worker-pool-errors",
  "prompt": "Redesign error handling across the worker pool. --strategy enterprise --depth deep --proposals 5",
  "topic": "redesign error handling across the worker pool",
  "expected": {
    "domain": "architecture",
    "strategy": "enterprise",
    "depth": "deep",
    "proposal_count": 5,
    "handoff": "none",
    "enrichment_expected": [
      "codebase",
      "research-deep"
    ]
  },
  "assertions": [
    {
      "text": "seed-brief.md exists",
      "type": "file_exists",
      "target": "with_skill/outputs/seed-brief.md"
    },
    {
      "text": "merged-requirements.md exists",
      "type": "file_exists",
      "target": "with_skill/outputs/merged-requirements.md"
    },
    {
      "text": "return-contract.yaml exists",
      "type": "file_exists",
      "target": "with_skill/outputs/return-contract.yaml"
    },
    {
      "text": "codebase enrichment artifact exists",
      "type": "file_exists",
      "target": "with_skill/outputs/enrichment/codebase-context.md"
    },
    {
      "text": "research-deep enrichment artifact exists",
      "type": "file_exists",
      "target": "with_skill/outputs/enrichment/research-deep.md"
    },
    {
      "text": "seed-brief frontmatter declares domain: architecture",
      "type": "frontmatter_field",
      "target": "with_skill/outputs/seed-brief.md",
      "field": "domain",
      "expected": "architecture"
    },
    {
      "text": "seed-brief frontmatter declares strategy: enterprise",
      "type": "frontmatter_field",
      "target": "with_skill/outputs/seed-brief.md",
      "field": "strategy",
      "expected": "enterprise"
    },
    {
      "text": "seed-brief frontmatter declares depth: deep",
      "type": "frontmatter_field",
      "target": "with_skill/outputs/seed-brief.md",
      "field": "depth",
      "expected": "deep"
    },
    {
      "text": "seed-brief frontmatter declares proposal_count: 5",
      "type": "frontmatter_field",
      "target": "with_skill/outputs/seed-brief.md",
      "field": "proposal_count",
      "expected": "5"
    },
    {
      "text": "merged-requirements frontmatter has spec_type",
      "type": "frontmatter_field",
      "target": "with_skill/outputs/merged-requirements.md",
      "field": "spec_type",
      "expected": "requirements"
    },
    {
      "text": "merged-requirements frontmatter has adversarial_status",
      "type": "frontmatter_field",
      "target": "with_skill/outputs/merged-requirements.md",
      "field": "adversarial_status",
      "expected": "pass"
    },
    {
      "text": "merged-requirements frontmatter has proposal_count: 5",
      "type": "frontmatter_field",
      "target": "with_skill/outputs/merged-requirements.md",
      "field": "proposal_count",
      "expected": "5"
    },
    {
      "text": "merged-requirements has Functional Requirements section \u22655 items",
      "type": "section_enumerated",
      "target": "with_skill/outputs/merged-requirements.md",
      "section_pattern": "Functional Requirements",
      "min_items": 5
    },
    {
      "text": "merged-requirements has Non-Functional Requirements section \u22653 items",
      "type": "section_enumerated",
      "target": "with_skill/outputs/merged-requirements.md",
      "section_pattern": "Non-Functional Requirements",
      "min_items": 3
    },
    {
      "text": "merged-requirements has Acceptance Criteria section \u22655 enumerated items",
      "type": "section_enumerated",
      "target": "with_skill/outputs/merged-requirements.md",
      "section_pattern": "Acceptance Criteria",
      "min_items": 5
    },
    {
      "text": "merged-requirements has Risks section \u22653 items",
      "type": "section_enumerated",
      "target": "with_skill/outputs/merged-requirements.md",
      "section_pattern": "Risks",
      "min_items": 3
    },
    {
      "text": "merged-requirements has Open Questions section \u22652 items",
      "type": "section_enumerated",
      "target": "with_skill/outputs/merged-requirements.md",
      "section_pattern": "Open Questions",
      "min_items": 2
    },
    {
      "text": "merged-requirements has Provenance section",
      "type": "section_present",
      "target": "with_skill/outputs/merged-requirements.md",
      "section_pattern": "Provenance"
    },
    {
      "text": "return-contract.yaml contract_version = 1.0",
      "type": "yaml_field",
      "target": "with_skill/outputs/return-contract.yaml",
      "field": "contract_version",
      "expected": "1.0"
    },
    {
      "text": "return-contract.yaml status = success",
      "type": "yaml_field",
      "target": "with_skill/outputs/return-contract.yaml",
      "field": "status",
      "expected": "success"
    },
    {
      "text": "return-contract.yaml convergence_score \u2265 0.50",
      "type": "yaml_field_min",
      "target": "with_skill/outputs/return-contract.yaml",
      "field": "convergence_score",
      "min_value": 0.5
    },
    {
      "text": "return-contract.yaml domain = architecture",
      "type": "yaml_field",
      "target": "with_skill/outputs/return-contract.yaml",
      "field": "domain",
      "expected": "architecture"
    },
    {
      "text": "return-contract.yaml proposal_count = 5",
      "type": "yaml_field",
      "target": "with_skill/outputs/return-contract.yaml",
      "field": "proposal_count",
      "expected": 5
    },
    {
      "text": "return-contract.yaml handoff_action = none",
      "type": "yaml_field",
      "target": "with_skill/outputs/return-contract.yaml",
      "field": "handoff_action",
      "expected": "none"
    },
    {
      "text": "return-contract.yaml agent_spec mentions \u22652 personas (architect, devops, qa, security, performance)",
      "type": "yaml_substring",
      "target": "with_skill/outputs/return-contract.yaml",
      "field": "agent_spec",
      "substring_any": [
        "architect",
        "devops",
        "qa",
        "security",
        "performance"
      ]
    },
    {
      "text": "return-contract.yaml agent_spec mentions \u22652 model aliases",
      "type": "yaml_substring",
      "target": "with_skill/outputs/return-contract.yaml",
      "field": "agent_spec",
      "substring_any": [
        "opus",
        "sonnet",
        "haiku"
      ]
    },
    {
      "text": "adversarial dir has \u22656 files (\u22655 proposals + debate-transcript)",
      "type": "dir_count",
      "target": "with_skill/outputs/adversarial/",
      "min_files": 6
    },
    {
      "text": "v1 baseline: requirements.md exists",
      "type": "file_exists",
      "target": "old_skill/outputs/requirements.md"
    },
    {
      "text": "v1 baseline: requirements.md has Acceptance Criteria section",
      "type": "section_present",
      "target": "old_skill/outputs/requirements.md",
      "section_pattern": "Acceptance Criteria"
    }
  ]
}
