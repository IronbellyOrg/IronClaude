{
  "eval_id": 6,
  "eval_name": "process-contributor-onboarding",
  "prompt": "Brainstorm how to improve the onboarding workflow for new contributors. --strategy agile --depth standard --proposals 3",
  "topic": "improve onboarding workflow for new contributors",
  "expected": {
    "domain": "process",
    "strategy": "agile",
    "depth": "standard",
    "proposal_count": 3,
    "handoff": "none",
    "enrichment_expected": []
  },
  "assertions": [
    {
      "text": "seed-brief.md exists",
      "type": "file_exists",
      "target": "with_skill/outputs/seed-brief.md"
    },
    {
      "text": "merged-requirements.md exists",
      "type": "file_exists",
      "target": "with_skill/outputs/merged-requirements.md"
    },
    {
      "text": "return-contract.yaml exists",
      "type": "file_exists",
      "target": "with_skill/outputs/return-contract.yaml"
    },
    {
      "text": "seed-brief frontmatter declares domain: process",
      "type": "frontmatter_field",
      "target": "with_skill/outputs/seed-brief.md",
      "field": "domain",
      "expected": "process"
    },
    {
      "text": "seed-brief frontmatter declares strategy: agile",
      "type": "frontmatter_field",
      "target": "with_skill/outputs/seed-brief.md",
      "field": "strategy",
      "expected": "agile"
    },
    {
      "text": "seed-brief frontmatter declares depth: standard",
      "type": "frontmatter_field",
      "target": "with_skill/outputs/seed-brief.md",
      "field": "depth",
      "expected": "standard"
    },
    {
      "text": "seed-brief frontmatter declares proposal_count: 3",
      "type": "frontmatter_field",
      "target": "with_skill/outputs/seed-brief.md",
      "field": "proposal_count",
      "expected": "3"
    },
    {
      "text": "merged-requirements frontmatter has spec_type",
      "type": "frontmatter_field",
      "target": "with_skill/outputs/merged-requirements.md",
      "field": "spec_type",
      "expected": "requirements"
    },
    {
      "text": "merged-requirements frontmatter has adversarial_status",
      "type": "frontmatter_field",
      "target": "with_skill/outputs/merged-requirements.md",
      "field": "adversarial_status",
      "expected": "pass"
    },
    {
      "text": "merged-requirements frontmatter has proposal_count: 3",
      "type": "frontmatter_field",
      "target": "with_skill/outputs/merged-requirements.md",
      "field": "proposal_count",
      "expected": "3"
    },
    {
      "text": "merged-requirements has Functional Requirements section \u22654 items",
      "type": "section_enumerated",
      "target": "with_skill/outputs/merged-requirements.md",
      "section_pattern": "Functional Requirements",
      "min_items": 4
    },
    {
      "text": "merged-requirements has Non-Functional Requirements section \u22652 items",
      "type": "section_enumerated",
      "target": "with_skill/outputs/merged-requirements.md",
      "section_pattern": "Non-Functional Requirements",
      "min_items": 2
    },
    {
      "text": "merged-requirements has Acceptance Criteria section \u22654 enumerated items",
      "type": "section_enumerated",
      "target": "with_skill/outputs/merged-requirements.md",
      "section_pattern": "Acceptance Criteria",
      "min_items": 4
    },
    {
      "text": "merged-requirements has Risks section \u22652 items",
      "type": "section_enumerated",
      "target": "with_skill/outputs/merged-requirements.md",
      "section_pattern": "Risks",
      "min_items": 2
    },
    {
      "text": "merged-requirements has Open Questions section \u22652 items",
      "type": "section_enumerated",
      "target": "with_skill/outputs/merged-requirements.md",
      "section_pattern": "Open Questions",
      "min_items": 2
    },
    {
      "text": "merged-requirements has Provenance section",
      "type": "section_present",
      "target": "with_skill/outputs/merged-requirements.md",
      "section_pattern": "Provenance"
    },
    {
      "text": "return-contract.yaml contract_version = 1.0",
      "type": "yaml_field",
      "target": "with_skill/outputs/return-contract.yaml",
      "field": "contract_version",
      "expected": "1.0"
    },
    {
      "text": "return-contract.yaml status = success",
      "type": "yaml_field",
      "target": "with_skill/outputs/return-contract.yaml",
      "field": "status",
      "expected": "success"
    },
    {
      "text": "return-contract.yaml convergence_score \u2265 0.50",
      "type": "yaml_field_min",
      "target": "with_skill/outputs/return-contract.yaml",
      "field": "convergence_score",
      "min_value": 0.5
    },
    {
      "text": "return-contract.yaml domain = process",
      "type": "yaml_field",
      "target": "with_skill/outputs/return-contract.yaml",
      "field": "domain",
      "expected": "process"
    },
    {
      "text": "return-contract.yaml proposal_count = 3",
      "type": "yaml_field",
      "target": "with_skill/outputs/return-contract.yaml",
      "field": "proposal_count",
      "expected": 3
    },
    {
      "text": "return-contract.yaml handoff_action = none",
      "type": "yaml_field",
      "target": "with_skill/outputs/return-contract.yaml",
      "field": "handoff_action",
      "expected": "none"
    },
    {
      "text": "return-contract.yaml agent_spec mentions \u22652 personas (scribe, mentor, refactorer, pm)",
      "type": "yaml_substring",
      "target": "with_skill/outputs/return-contract.yaml",
      "field": "agent_spec",
      "substring_any": [
        "scribe",
        "mentor",
        "refactorer",
        "pm",
        "architect"
      ]
    },
    {
      "text": "return-contract.yaml agent_spec mentions \u22652 model aliases",
      "type": "yaml_substring",
      "target": "with_skill/outputs/return-contract.yaml",
      "field": "agent_spec",
      "substring_any": [
        "opus",
        "sonnet",
        "haiku"
      ]
    },
    {
      "text": "adversarial dir has \u22654 files (\u22653 proposals + debate-transcript)",
      "type": "dir_count",
      "target": "with_skill/outputs/adversarial/",
      "min_files": 4
    },
    {
      "text": "v1 baseline: requirements.md exists",
      "type": "file_exists",
      "target": "old_skill/outputs/requirements.md"
    },
    {
      "text": "v1 baseline: requirements.md has Acceptance Criteria section",
      "type": "section_present",
      "target": "old_skill/outputs/requirements.md",
      "section_pattern": "Acceptance Criteria"
    }
  ]
}
