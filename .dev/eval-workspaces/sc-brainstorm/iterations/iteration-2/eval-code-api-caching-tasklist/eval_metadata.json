{
  "eval_id": 8,
  "eval_name": "code-api-caching-tasklist",
  "prompt": "Brainstorm: add caching to the API layer. --depth standard --proposals 3 --handoff tasklist",
  "topic": "add caching to the API layer",
  "expected": {
    "domain": "code",
    "strategy": "systematic",
    "depth": "standard",
    "proposal_count": 3,
    "enrichment_expected": [
      "codebase"
