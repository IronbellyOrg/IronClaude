     """runner.py launches reflect ONLY via ClaudeProcess (no agent surface)."""
     src = _RUNNER_SRC.read_text(encoding="utf-8")
     assert "ClaudeProcess" in src
-    for banned in ("import anthropic", "from anthropic", "subagent", "Task("):
+    # NOTE: the banned tokens target the agent-spawn *surface* (imports + Agent/Task spawn
+    # calls), NOT English prose. The FR-INLINE directive STRING legitimately discusses a
+    # "subagent" as data it sends to the remote headless agent, so we guard the actual spawn
+    # kwarg `subagent_type` / `Agent(` rather than the bare word "subagent".
+    for banned in (
+        "import anthropic",
+        "from anthropic",
+        "subagent_type",
+        "Agent(",
+        "Task(",
+    ):
         assert banned not in src, (
             f"agent-surface token leaked into runner.py: {banned!r}"
         )
