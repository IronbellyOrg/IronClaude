+    if lines and lines[0].strip() == "---":
+        for line in lines[1:]:
+            if line.strip() == "---":
+                break
+            key_match = re.match(
+                r"\s*(?:status|verdict)\s*:\s*(.+?)\s*$", line, re.IGNORECASE
+            )
+            if key_match:
+                token = _CHECKPOINT_VERDICT_RE.search(key_match.group(1))
+                if token:
+                    return token.group(1).upper()
